# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=ml-laboratory-super-secret-key-dev-2025
PORT=5000

# JWT Configuration
JWT_SECRET=jwt-ml-lab-secret-key-super-secure-change-in-prod
JWT_EXPIRATION_HOURS=24
ADMIN_EMAIL=your-real-admin-email@example.com
ADMIN_PASSWORD=change-this-admin-password

# Email OTP (required for every login and registration)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@mllab.com
SMTP_FROM_NAME=ML Laboratory Security
OTP_EXPIRATION_MINUTES=5

# MongoDB Configuration (Local or MongoDB Atlas)
# Example local: mongodb://localhost:27017
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=ml_laboratory

# Execution Sandbox Configuration
# Options: 'subprocess' (hardened local worker) or 'docker' (container isolation)
EXECUTION_BACKEND=subprocess
EXECUTION_TIMEOUT=6
MAX_CODE_SIZE=50000
MAX_OUTPUT_SIZE=50000

# CORS Configuration
# Add the exact Vercel origin, without a trailing slash.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://mllab-omega.vercel.app
