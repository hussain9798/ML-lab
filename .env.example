# Copy this file to .env before running Docker Compose.
# Generate both secrets with a password manager or:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET=replace-with-a-different-long-random-secret

ADMIN_EMAIL=your-real-admin-email@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sending-gmail@example.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=your-sending-gmail@example.com
SMTP_FROM_NAME=ML Laboratory Security
OTP_EXPIRATION_MINUTES=5

# Use MongoDB Atlas in production, or leave this unset for the bundled MongoDB container.
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=ml_laboratory
CORS_ORIGINS=http://localhost:5173
EXECUTION_BACKEND=subprocess
EXECUTION_TIMEOUT=6
